# Copy to .env and edit:  cp .env.example .env && nano .env
ADMIN_USERNAME=quickgeo_admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
PORT=3000
SESSION_HOURS=24
MAX_BODY_MB=10
# VAPID keys are auto-generated into data/vapid.json on first start. Back that file up:
# if it changes, every existing subscriber stops receiving notifications.
# VAPID_SUBJECT=mailto:quickgeoofficial@gmail.com
# INDEXNOW_ENABLED=true
